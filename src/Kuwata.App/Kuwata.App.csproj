<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Позволяет собирать (но не запускать) на Linux/macOS, например в CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Kuwata</AssemblyName>
    <RootNamespace>Kuwata.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Core.Wpf" Version="2.27.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kuwata.Core\Kuwata.Core.csproj" />
  </ItemGroup>

</Project>
